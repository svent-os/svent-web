#!/bin/sh
set -eu
jar=/opt/sv-burpsuite/burpsuite.jar
if [ "${1:-}" = "--sv-check" ]; then
    test -s "$jar"
    unzip -tq "$jar" >/dev/null
    command -v java >/dev/null
    exit 0
fi
if [ ! -s "$jar" ]; then
    printf 'Burp Suite is not installed completely. Reinstall sv-burpsuite.\n' >&2
    exit 1
fi
exec java -jar "$jar" "$@"

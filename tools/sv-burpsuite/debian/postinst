#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    directory=/opt/sv-burpsuite
    jar="$directory/burpsuite.jar"
    icon=/usr/share/pixmaps/sv-burpsuite.svg
    mkdir -p "$directory" /usr/share/pixmaps
    temporary=$(mktemp -d "$directory/.download.XXXXXX")
    trap 'rm -rf "$temporary"' EXIT HUP INT TERM
    if [ ! -s "$jar" ] || ! unzip -tq "$jar" >/dev/null 2>&1; then
        curl -fL --retry 3 --connect-timeout 30 --max-time 900 'https://portswigger.net/burp/releases/download?product=community&type=Jar' -o "$temporary/burpsuite.jar"
        unzip -tq "$temporary/burpsuite.jar" >/dev/null
        install -m 0644 "$temporary/burpsuite.jar" "$jar"
    fi
    curl -fL --retry 3 --connect-timeout 30 --max-time 120 'https://portswigger.net/content/images/svg/icons/community.svg' -o "$temporary/icon.svg"
    grep -q '<svg' "$temporary/icon.svg"
    install -m 0644 "$temporary/icon.svg" "$icon"
    rm -f /usr/share/pixmaps/sv-burpsuite.png
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q
    fi
fi
#DEBHELPER#
